# Database URL
# For local development (SQLite):
DATABASE_URL="file:./db/custom.db"

# For Hostinger deployment (MySQL database auto-connect):
# Hostinger provides MySQL databases with their hosting plans.
# 1. Create a MySQL database in Hostinger hPanel → Databases → MySQL
# 2. Get credentials: Database name, Username, Password, Host
# 3. Set the DATABASE_URL below with your Hostinger MySQL credentials:
#    DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME"
#    Example: DATABASE_URL="mysql://u123456789_gardening:Password123@127.0.0.1:3306/u123456789_gardening"
# 4. Change prisma provider from "sqlite" to "mysql" in prisma/schema.prisma
# 5. Run: bun run db:push (to create tables on Hostinger)
#
# For Vercel deployment:
# 1. Turso (cloud SQLite) - recommended: https://turso.tech
#    DATABASE_URL="libsql://your-db.turso.io"
#    Also set: TURSO_AUTH_TOKEN="your-token"
#    And change prisma provider from "sqlite" to "libsql"
#
# 2. Vercel Postgres: https://vercel.com/docs/storage/vercel-postgres
#    DATABASE_URL="postgresql://..."
#    And change prisma provider from "sqlite" to "postgresql"
