# Database URL
# For local development (SQLite):
DATABASE_URL="file:./db/custom.db"

# For Vercel deployment, use one of:
# 1. Turso (cloud SQLite) - recommended: https://turso.tech
#    DATABASE_URL="libsql://your-db.turso.io"
#    Also set: TURSO_AUTH_TOKEN="your-token"
#    And change prisma provider from "sqlite" to "libsql"
#
# 2. Vercel Postgres: https://vercel.com/docs/storage/vercel-postgres
#    DATABASE_URL="postgresql://..."
#    And change prisma provider from "sqlite" to "postgresql"
#
# 3. Temporary SQLite (data resets on each cold start):
#    DATABASE_URL="file:/tmp/custom.db"
